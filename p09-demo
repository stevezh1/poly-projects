import pandas as pd
import numpy as np
import seaborn as sns
import matplotlib.pyplot as plt
#!pip install shap
import shap
import joblib


import sklearn
from sklearn.model_selection import train_test_split
from sklearn.model_selection import GridSearchCV
from sklearn.tree import DecisionTreeRegressor
from sklearn.preprocessing import LabelEncoder,  OneHotEncoder,OrdinalEncoder
from sklearn.pipeline import Pipeline
from sklearn.compose import ColumnTransformer
from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score , mean_absolute_percentage_error
from sklearn.model_selection import ShuffleSplit
from sklearn.model_selection import cross_val_score

randomstate = 123456

laptop=pd.read_csv('/content/laptop_prices_2024_sgd.csv')

#setup df to contain all scores across various "engineering" or PDCA cycles, for easy reading
results = pd.DataFrame(['cv_mae_test','cv_std_test','cv_mae_train','cv_std_train','best'])
results

df_mod = laptop.copy()

from sklearn.preprocessing import TargetEncoder
X=df_mod.drop(['Price_SGD'],axis=1)
y=df_mod['Price_SGD']
# Holdout Strategy
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, random_state=randomstate)
# Assuming 'categorical_features' is the list of categorical column names
categorical_features = X_train.select_dtypes(include=['object']).columns.tolist()
# Apply Label Encoder to categorical columns
preprocessor = ColumnTransformer(transformers=[
    ('cat', TargetEncoder(), categorical_features)
], remainder='passthrough')
# Create a Decision Tree Regressor
dtr = DecisionTreeRegressor(random_state=randomstate)
# Create a pipeline
pipeline = Pipeline(steps=[
    ('preprocessor', preprocessor),
    ('regressor', dtr)
])
# Define the parameter grid for GridSearchCV
param_grid = {
    'regressor__max_depth':  range(5, 30, 5)  # Varying depths to scan
}
# Initialize GridSearchCV
cv = ShuffleSplit(n_splits=5, test_size=0.2, random_state=randomstate)
grid_search = GridSearchCV(pipeline, param_grid, cv=5, scoring='neg_mean_absolute_error', n_jobs=-1)
# Fit the model on training data
grid_search.fit(X_train, y_train)
# Print the best parameters and best score
print("Best parameters:", grid_search.best_params_)
print("Best score:", grid_search.best_score_)
# Using cross_val_score with the best estimator
scores_test = cross_val_score(grid_search.best_estimator_, X_test, y_test, cv=cv, scoring='neg_mean_absolute_error', n_jobs=-1)
scores_train = cross_val_score(grid_search.best_estimator_, X_train, y_train, cv=cv, scoring='neg_mean_absolute_error', n_jobs=-1)

# Calculate and print mean and standard deviation for test and train sets
mean_score_test = scores_test.mean()
std_score_test = scores_test.std()
mean_score_train = scores_train.mean()
std_score_train = scores_train.std()


results_in = pd.DataFrame([mean_score_test,
                           std_score_test,
                           mean_score_train,
                           std_score_train,
                          grid_search.best_params_],
                         columns=['targetencode'])

results=pd.concat([results , results_in], axis = 1)
results

from sklearn.inspection import permutation_importance

# Compute permutation importance
perm_importance = permutation_importance(grid_search.best_estimator_, X_test, y_test, n_repeats=30, random_state=randomstate, n_jobs=-1)

# Extract feature names
feature_names = X.columns.tolist()

# Create a DataFrame to display feature importance
df_feature_importance = pd.DataFrame(perm_importance.importances_mean, index=feature_names, columns=["Importance"])

# Sort the DataFrame by importance
df_feature_importance.sort_values(by="Importance", ascending=False, inplace=True)

# Display the feature importance
print(df_feature_importance)

import matplotlib.pyplot as plt

# Plot the feature importance
plt.figure(figsize=(10, 6))
df_feature_importance['Importance'].plot(kind='bar')
plt.title('Permutation Feature Importance')
plt.xlabel('Features')
plt.ylabel('Importance')
plt.xticks(rotation=45)
plt.show()

# Initialize SHAP
#shap.initjs()

# Initialize SHAP explainer with the fitted Random Forest Regressor
explainer = shap.TreeExplainer(grid_search.best_estimator_.named_steps['regressor'])

# Use the preprocessor inside the pipeline to transform the test data
X_test_transformed = grid_search.best_estimator_.named_steps['preprocessor'].transform(X_test)

# Compute SHAP values for the test set
shap_values = explainer.shap_values(X_test_transformed)

# Access feature names from the fitted preprocessor inside the pipeline
transformed_feature_names = grid_search.best_estimator_.named_steps['preprocessor'].get_feature_names_out()
print("\nShape of X_test_transformed:", X_test_transformed.shape)
print("\nTransformed Feature Names:")
print(transformed_feature_names)

# Convert the preprocessed test data to a DataFrame for plotting
X_test_preprocessed_df = pd.DataFrame(X_test_transformed, columns=transformed_feature_names)

# Create a mapping from original features to transformed feature indices
feature_indices = {}
for feature in X.columns:
    matching_cols = [i for i, name in enumerate(transformed_feature_names) if feature in name]
    feature_indices[feature] = matching_cols

# Print feature indices for debugging
print("\nFeature Indices Mapping:")
for feature, indices in feature_indices.items():
    print(f"{feature}: {indices}")

# Number of original features
num_features = len(X.columns)

import math
# Define the number of columns per row
num_columns = 2
num_features = len(X.columns)  # Assuming X.columns contains the features
num_rows = math.ceil(num_features / num_columns)  # Calculate the required number of rows

# Create subplots: num_rows rows, num_columns columns
fig, axes = plt.subplots(nrows=num_rows, ncols=num_columns, figsize=(5 * num_columns, 6 * num_rows), sharey=True)

# Flatten the axes array for easier indexing (if more than one row is present)
axes = axes.flatten()

# Plot SHAP scatter plots (without marginal effects)
for idx, feature in enumerate(X.columns):
    if feature not in feature_indices:
        print(f"Feature '{feature}' not found in feature_indices. Skipping.")
        continue

    cols = feature_indices[feature]

    # Initialize SHAP values and feature values
    if feature in categorical_features:
        # Categorical feature: sum SHAP values across all related columns
        shap_values_feature = shap_values[:, cols].sum(axis=1)
        feature_values = X_test[feature].values  # Original categorical feature values
    else:
        # Numerical feature: single SHAP value
        shap_values_feature = shap_values[:, cols[0]]
        feature_values = X_test[feature].values  # Original numerical feature values

    ax = axes[idx]

    # For numerical features
    if pd.api.types.is_numeric_dtype(X[feature]):
        scatter = ax.scatter(
            feature_values,
            shap_values_feature,
            c=shap_values_feature,
            cmap='coolwarm',
            alpha=0.6,
            edgecolor='k'
        )
        ax.set_title(f"{feature}")
        ax.set_xlabel(feature)
        if idx % num_columns == 0:  # Set ylabel for the first column of each row
            ax.set_ylabel("SHAP value")
    else:
        # For categorical features
        x_vals = np.unique(feature_values)
        y_vals = []
        for val in x_vals:
            mask = feature_values == val
            y_vals.append(shap_values_feature[mask].mean())
        ax.bar(x_vals, y_vals, color='blue', label='Mean SHAP value')
        ax.set_xticklabels(x_vals, rotation=90)
        ax.set_title(f"{feature}")
        ax.set_xlabel(feature)
        if idx % num_columns == 0:  # Set ylabel for the first column of each row
            ax.set_ylabel("SHAP value")

# Remove empty subplots (if any)
for ax in axes[num_features:]:
    fig.delaxes(ax)

# Adjust layout
plt.tight_layout()
plt.show()

#lineplot y_pred
plt.figure(figsize=(10, 6))
plt.plot(y_test.reset_index(drop=True), label = 'actual')
plt.plot(grid_search.best_estimator_.predict(X_test), label = 'predicted')
plt.title('True vs. Predicted Values')
plt.xlim(75,85)
#useful as a zoom tool, to focus which index may be interesting
plt.legend()
plt.show()


