import ipywidgets as widgets
from IPython.display import display, clear_output
import random

# Character class definition
class Character:
    def __init__(self, name, hp, min_ap, max_ap, sp, skills=None):
        self.name = name
        self.hp = hp
        self.max_hp = hp
        self.min_ap = min_ap
        self.max_ap = max_ap
        self.sp = sp
        self.skills = skills if skills else []
        
    def attack(self, target):
        dmg = random.randint(self.min_ap, self.max_ap)
        target.hp = max(0, target.hp - dmg)
        return dmg

class ColabRPGApp:
    def __init__(self):
        self.player = None
        self.enemies = []
        
        # UI Container and Output areas
        self.container = widgets.VBox()
        self.output = widgets.Output()
        
        self.show_character_selection()

    def display_app(self):
        display(self.container, self.output)

    def show_character_selection(self):
        with self.output:
            clear_output()
            print("Welcome to the RPG Game Arena!")
        
        self.char_dropdown = widgets.Dropdown(
            options=[
                ('Knight (Balanced Stats, Combo Skill)', 'Knight'), 
                ('Warrior (High HP & Health Boost)', 'Warrior'), 
                ('Mage (Special Venom Skill)', 'Mage')
            ],
            description='Hero:',
        )
        self.btn_select = widgets.Button(description="Start Adventure", button_style='success')
        self.btn_select.on_click(self.on_character_selected)
        
        self.container.children = [
            widgets.HTML("<h3>Choose Your Character Class</h3>"), 
            self.char_dropdown, 
            self.btn_select
        ]

    def on_character_selected(self, b):
        char_type = self.char_dropdown.value
        if char_type == 'Knight':
            self.player = Character("Knight", 120, 10, 25, 10, ["Combo Damage"])
        elif char_type == 'Warrior':
            self.player = Character("Warrior", 150, 12, 20, 15, ["Health Boost"])
        else:
            self.player = Character("Mage", 115, 8, 28, 8, ["Slow Venom"])
            
        # Initialize Enemies
        self.enemies = [
            Character("Defender", 100, 10, 18, 12),
            Character("Barbarian", 110, 12, 22, 10)
        ]
        
        self.show_battle_screen()

    def show_battle_screen(self):
        with self.output:
            clear_output()
            print(f"Battle started! You are playing as a {self.player.name}.")
            print(f"Your HP: {self.player.hp} | Enemies Remaining: {len(self.enemies)}")
            
        self.btn_attack = widgets.Button(description="Standard Attack", button_style='danger')
        self.btn_skill = widgets.Button(description=f"Use Skill ({self.player.skills[0]})", button_style='warning')
        self.btn_restart = widgets.Button(description="Main Menu", button_style='info')
        
        self.btn_attack.on_click(self.on_attack)
        self.btn_skill.on_click(self.on_skill)
        self.btn_restart.on_click(lambda x: self.show_character_selection())
        
        self.container.children = [
            widgets.HTML(f"<h3>Battle Arena — {self.player.name} (HP: {self.player.hp})</h3>"),
            widgets.HBox([self.btn_attack, self.btn_skill, self.btn_restart])
        ]

    def on_attack(self, b):
        with self.output:
            clear_output(wait=True)
            if not self.enemies:
                print("🎉 All enemies defeated! You win!")
                self.container.children = [widgets.HTML("<h3>Victory! All enemies defeated.</h3>")]
                return
            
            target = self.enemies[0]
            dmg = self.player.attack(target)
            print(f"⚔️ You attacked {target.name} for {dmg} damage! ({target.name} HP: {target.hp})")
            
            if target.hp <= 0:
                print(f"💥 {target.name} was defeated!")
                self.enemies.pop(0)
                if not self.enemies:
                    print("🏆 Victory! You cleared the arena!")
                    self.container.children = [widgets.HTML("<h3>Victory! You win!</h3>")]
                    return

            # Enemy Counterattack
            self.process_enemy_turn()

    def on_skill(self, b):
        with self.output:
            clear_output(wait=True)
            skill_name = self.player.skills[0]
            if skill_name == "Health Boost":
                heal = random.randint(20, 40)
                self.player.hp = min(self.player.max_hp, self.player.hp + heal)
                print(f"✨ Used Health Boost! Restored {heal} HP. Current HP: {self.player.hp}")
            else:
                if self.enemies:
                    target = self.enemies[0]
                    dmg = random.randint(30, 50)
                    target.hp = max(0, target.hp - dmg)
                    print(f"🔥 Used {skill_name} on {target.name} for massive {dmg} damage! ({target.name} HP: {target.hp})")
                    if target.hp <= 0:
                        print(f"💥 {target.name} was defeated!")
                        self.enemies.pop(0)
                
            if not self.enemies:
                print("🏆 Victory! You defeated all enemies!")
                self.container.children = [widgets.HTML("<h3>Victory! You win!</h3>")]
                return

            self.process_enemy_turn()

    def process_enemy_turn(self):
        for enemy in self.enemies:
            if enemy.hp > 0:
                edmg = enemy.attack(self.player)
                print(f"🛡️ {enemy.name} retaliated for {edmg} damage! Your HP: {self.player.hp}")
                if self.player.hp <= 0:
                    print("💀 Game Over! You were defeated.")
                    self.container.children = [widgets.HTML("<h3>Game Over</h3>")]
                    self.btn_attack.disabled = True
                    self.btn_skill.disabled = True
                    return

# Run the app inside Colab
game = ColabRPGApp()
game.display_app()
