import tkinter as tk
from tkinter import messagebox
import random
import time

# Character class
class Character:
    def __init__(self, name, hp, min_hp, max_hp, min_ap, max_ap, min_combo, max_combo,
                 mp, max_mp, sp, magic_skills):
        self.name = name
        self.hp = hp
        self.min_hp = min_hp
        self.max_hp = max_hp
        self.min_ap = min_ap
        self.max_ap = max_ap
        self.min_combo = min_combo
        self.max_combo = max_combo
        self.mp = mp
        self.max_mp = max_mp
        self.sp = sp
        self.magic_skills = magic_skills
    
    def reset_stats(self):
        self.hp = self.max_hp
        self.mp = self.max_mp
    
    def attack(self, target):
        ap = random.randint(self.min_ap, self.max_ap)
        target.hp -= ap
        
    def combo_damage(self, target):
        combo_ap = random.randint(self.min_combo, self.max_combo)
        target.hp -= combo_ap
    
    def health_boost(self):
        hp = random.randint(self.min_hp, self.max_hp)
        self.hp += hp
    
    def slow_venom(self, target):
        damage_per_turn = 20
        target.hp -= damage_per_turn
          
    def time_warp(self):
        pass

# Game class
class Game:
    def __init__(self):
        self.players = []
        self.enemies = []
        self.game_in_progress = False
    
    def create_enemies(self):
        return [
            Character(name="Enemy 1", hp=125, min_hp=0, max_hp=125, 
                      min_ap=15, max_ap=20, min_combo=0, max_combo=0,
                      mp=12, max_mp=12, sp=15, magic_skills=[]),
            Character(name="Enemy 2", hp=115, min_hp=0, max_hp=115,
                      min_ap=12, max_ap=24, min_combo=0, max_combo=0,
                      mp=8, max_mp=8, sp=11, magic_skills=[]),
            Character(name="Enemy 3", hp=150, min_hp=0, max_hp=150, 
                      min_ap=10, max_ap=20, min_combo=0, max_combo=0,
                      mp=10, max_mp=10, sp=15, magic_skills=[])
        ]
    
    def init_game(self):
        self.enemies = self.create_enemies()
        self.game_in_progress = True

class SettingsPage(tk.Frame):
    def __init__(self, parent, controller):
        super().__init__(parent)
        self.controller = controller

        label = tk.Label(self, text="Settings", font=("Arial", 14, "bold"))
        label.pack(pady=10)

        volume_label = tk.Label(self, text="Adjust Volume:")
        volume_label.pack()

        volume_scale = tk.Scale(self, from_=0, to=100, orient=tk.HORIZONTAL)
        volume_scale.pack(pady=5)

        difficulty_label = tk.Label(self, text="Difficulty Level:")
        difficulty_label.pack()

        difficulty_scale = tk.Scale(self, from_=1, to=3, orient=tk.HORIZONTAL)
        difficulty_scale.pack(pady=5)

        back_button = tk.Button(self, text="Back to Main Menu", command=lambda: controller.change_frame("StartPage"))
        back_button.pack(pady=20)

class StartPage(tk.Frame):
    def __init__(self, parent, controller):
        super().__init__(parent)
        self.controller = controller

        label = tk.Label(self, text="Main Menu", font=("Arial", 16, "bold"))
        label.pack(pady=20)

        start_button = tk.Button(self, text="Start Game", width=20, height=2, command=lambda: controller.change_frame("SelectionPage"))
        start_button.pack(pady=10)

        settings_button = tk.Button(self, text="Settings", width=20, height=2, command=lambda: controller.change_frame("SettingsPage"))
        settings_button.pack(pady=10)

        quit_button = tk.Button(self, text="Quit", width=20, height=2, command=parent.master.destroy)
        quit_button.pack(pady=10)

class SelectionPage(tk.Frame):
    def __init__(self, parent, controller, game):
        super().__init__(parent)
        self.controller = controller
        self.game = game
        
        label = tk.Label(self, text="Player Selection", font=("Arial", 16, "bold"))
        label.pack(pady=10)
        
        self.characters = [
            {"name": "Knight", "stats": "HP: 120, AP: 10-25, Speed: 10", "skills": ["combo_damage"]},
            {"name": "Warrior", "stats": "HP: 120, AP: 10-25, Speed: 15", "skills": ["time_warp", "health_boost"]},
            {"name": "Mage", "stats": "HP: 120, AP: 10-25, Speed: 8", "skills": ["slow_venom"]}
        ]
        
        for char_info in self.characters:
            btn = tk.Button(
                self,
                text=f"Select {char_info['name']} ({char_info['stats']})",
                width=45,
                height=2,
                command=lambda c=char_info: self.select_character(c)
            )
            btn.pack(pady=5)

        back_button = tk.Button(self, text="Back to Main Menu", command=lambda: controller.change_frame("StartPage"))
        back_button.pack(pady=20)

    def select_character(self, character):
        new_player = Character(
            name=character["name"],
            hp=120, min_hp=15, max_hp=30,
            min_ap=10, max_ap=25, min_combo=25, max_combo=50,
            mp=15, max_mp=15, sp=10, magic_skills=character["skills"]
        )
        self.game.players.append(new_player)
        messagebox.showinfo("Selection", f"You selected {character['name']}!")
        self.game.init_game()
        self.controller.change_frame("BattlePage")

class BattlePage(tk.Frame):
    def __init__(self, parent, controller, game):
        super().__init__(parent)
        self.controller = controller
        self.game = game

        label = tk.Label(self, text="Battle Page", font=("Arial", 16, "bold"))
        label.pack(pady=10)

        self.status_label = tk.Label(self, text="Battle in progress...", font=("Arial", 12))
        self.status_label.pack(pady=10)

        attack_options = ["Combo Damage", "Time Warp", "Health Boost", "Slow Venom", "Standard Attack"]
        self.selected_attack = tk.StringVar(value=attack_options[0])

        option_menu = tk.OptionMenu(self, self.selected_attack, *attack_options)
        option_menu.pack(pady=5)

        action_button = tk.Button(self, text="Perform Action", command=self.perform_action, width=20, height=2)
        action_button.pack(pady=10)

        back_button = tk.Button(self, text="Back to Selection", command=lambda: controller.change_frame("SelectionPage"))
        back_button.pack(pady=20)

    def perform_action(self):
        action = self.selected_attack.get()
        messagebox.showinfo("Action", f"Performed: {action}")

class MyApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("My RPG Game")
        self.geometry("800x600")

        self.game = Game()

        container = tk.Frame(self)
        container.pack(side="top", fill="both", expand=True)
        container.grid_rowconfigure(0, weight=1)
        container.grid_columnconfigure(0, weight=1)

        self.frames = {}
        for F in (StartPage, SettingsPage, SelectionPage, BattlePage):
            page_name = F.__name__
            if F in (SelectionPage, BattlePage):
                frame = F(parent=container, controller=self, game=self.game)
            else:
                frame = F(parent=container, controller=self)
            
            self.frames[page_name] = frame
            frame.grid(row=0, column=0, sticky="nsew")

        self.change_frame("StartPage")

    def change_frame(self, page_name):
        frame = self.frames[page_name]
        frame.tkraise()

if __name__ == "__main__":
    app = MyApp()
    app.mainloop()
