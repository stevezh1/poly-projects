        label.pack(pady=10)

        start_button = tk.Button(self, text="Start", command=self.start_game)
        start_button.pack(pady=20, anchor="center")

        settings_button = tk.Button(self, text="Settings", command=self.settings)
        settings_button.pack(pady=20, anchor="center")

        quit_button = tk.Button(self, text="Quit", command=self.quit_game)
        quit_button.pack(pady=20, anchor="center")

    def start_game(self):
        self.parent.show_frame("SelectionPage")

    def settings(self):
        self.parent.show_frame("SettingsPage")

    def quit_game(self):
        self.parent.destroy()  # Close the entire application

