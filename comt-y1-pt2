class BattlePage(tk.Frame):
    def __init__(self, parent, controller, game):
        tk.Frame.__init__(self, parent)
        self.controller = controller
        self.game = game  # Store the game instance
        self.enemies = self.game.enemies
        self.players = self.game.players

        label = tk.Label(self, text="Battle Page")
        label.pack(pady=10)

        # AttackPage content
        label = tk.Label(self, text="Select your attack:")
        label.pack()

        attack_options = ["Combo Damage", "Time Warp", "Health Boost", "Slow Venom"]
        selected_attack = tk.StringVar()
        selected_attack.set(attack_options[0])

        option_menu = tk.OptionMenu(self, selected_attack, *attack_options)
        option_menu.pack()

        attack_button1 = tk.Button(self, text="Combo Damage", command=self.perform_attack)
        attack_button1.pack()

        # Add other attack buttons similarly

        back_button = tk.Button(self, text="Back to Selection", command=self.back_to_selection)
        back_button.pack(pady=20)

    def perform_attack(self):
        selected_attack = self.selected_attack.get()
        print(f"Performing attack: {selected_attack}")
        self.controller.show_frame("BattlePage")  # Close the attack screen

    def enemy_attack(self):
        print("\nEnemies' turn")
        for enemy in self.enemies:
            if not self.check_players_alive():
                break

            if enemy.hp > 0:
                print(f"Enemy HP: {enemy.hp} ", end="")
                target_player = random.choice(self.players)
                enemy.attack(target_player)  # Call NPC's attack method
                print(f"Enemy attacked {target_player.name} and dealt damage.")
                time.sleep(1)
                if not self.player_alive(target_player):
                    print(f"{target_player.name} was defeated!")

    def back_to_selection(self):
        self.controller.show_frame("SelectionPage")
        
class MyApp(tk.Tk):
    def __init__(self):
        tk.Tk.__init__(self)
        self.frames = {}
        self.game = Game()  # Create a game instance
        
        container = tk.Frame(self)
        container.pack(side="top", fill="both", expand=True)
        container.grid_rowconfigure(0, weight=1)
        container.grid_columnconfigure(0, weight=1)

        self.frames = {}
        for F in (StartPage, SelectionPage, BattlePage):
            page_name = F.__name__
            if F == BattlePage:
                frame = F(parent=self, controller=self, game=self.game)  # Pass game instance
            else:
                frame = F(parent=self, controller=self)  # StartPage and SelectionPage
            self.frames[page_name] = frame
            frame.pack()
            
        frame.grid(row=0, column=0, sticky="nsew")

        self.change_frame("StartPage")

    def change_frame(self, page_name):
        frame = self.frames[page_name]
        frame.tkraise()

if __name__ == "__main__":
    app = MyApp()
    app.mainloop()
