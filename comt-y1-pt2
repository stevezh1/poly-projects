class GameGUI(tk.Tk):
    def __init__(self, parent, controller):
        super().__init__()
        self.title("My RPG Game")
        self.geometry("800x600")

        self.game = Game()
        self.current_frame = None

        self.frames = {}

        start_page = StartPage(self, self.game)
        selection_page = SelectionPage(self, self.game)
        battle_page = BattlePage(self, self.game) 

        self.frames["StartPage"] = start_page
        self.frames["SelectionPage"] = selection_page
        self.frames["BattlePage"] = battle_page

        self.show_frame("StartPage")

    def show_frame(self, frame_name):
        frame = self.frames[frame_name]
        if self.current_frame:
            self.current_frame.pack_forget()
        frame.pack()
        self.current_frame = frame

class StartPage(tk.Frame):
