# 2. BOOKING DATA ANALYSIS
# ==========================================
print("=== LOADING BOOKING DATA ===")
booking_data = pd.read_csv("Booking data.csv")

# Display data info and first 10 rows
print("\nData Types:")
print(booking_data.dtypes)

print("\nFirst 10 rows of Booking Data:")
display(booking_data.head(10))  # display() works nicely in Colab instead of print()

print("\n" + "="*50 + "\n")
print("=== COMPREHENSIVE EXPLORATION OF BOOKING DATA ===")

for column in booking_data.columns:
    print(f"Column: {column}")
    print("-" * 50)
    
    if booking_data[column].dtype == 'object':
        category_count = booking_data[column].value_counts()
        print("Count of each category:\n", category_count)
        
        category_percentage = booking_data[column].value_counts(normalize=True) * 100
        print("Percentage of each category:\n", category_percentage)
    else:
        column_stats = booking_data[column].describe()
        print("Basic statistics:\n", column_stats)
        
    print("\n" + "-"*50 + "\n")

# --- Filtered Analysis for 'Tivoli_4' ---
print("=== FILTERED ANALYSIS (hotel_id == 'Tivoli_4') ===")
booking_data_filtered = booking_data[booking_data['hotel_id'] == 'Tivoli_4']

for column in booking_data_filtered.select_dtypes(include='object').columns:
    print(f"Column: {column}")
    
    category_count = booking_data_filtered[column].value_counts()
    print("Count of each category:\n", category_count)
    
    category_percentage = booking_data_filtered[column].value_counts(normalize=True) * 100
    print("Percentage of each category:\n", category_percentage)
    print("\n" + "-"*50 + "\n")

