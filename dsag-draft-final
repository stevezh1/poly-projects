import re

def menu_display():
    print("1. Check Palindrome")
    print("2. Check Palindrome by Word Unit")
    print("3. Quit")

def palindrome(s):
    clean_s = re.sub(r'[^a-zA-Z0-9]', '', s.lower())
    return clean_s == clean_s[::-1]

def palindrome_word_unit(s):
    clean_s = re.sub(r'[^a-zA-Z0-9 ]', '', s.lower())
    words = clean_s.split()
    return words == words[::-1]

# Main program
while True:
    menu_display()
    choice = input("Enter your choice (1-3): ")

    if choice == '1':
        string_to_check = input("Enter a string to check for palindrome: ")
        if palindrome(string_to_check):
            print("It's a palindrome!")
        else:
            print("It's not a palindrome.")
    elif choice == '2':
        sentence_to_check = input("Enter a sentence to check for palindrome by word unit: ")
        if palindrome_word_unit(sentence_to_check):
            print("It's a palindrome by word unit!")
        else:
            print("It's not a palindrome by word unit.")
    elif choice == '3':
        print("Exiting the program. Goodbye!")
        break
    else:
        print("Invalid choice. Please enter a number between 1 and 3.")

