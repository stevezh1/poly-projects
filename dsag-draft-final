import random
import json
from collections import deque
from questions_file import questions

def read_questions_from_file(file_path):
    with open(file_path, 'r') as file:
        questions_data = json.load(file)
    return questions_data
    
def generate_quiz(questions, num_questions, randomize_questions, randomize_options):
    quiz = questions.copy()

    if randomize_questions:
        random.shuffle(quiz)

    for q in quiz:
        if randomize_options:
            random.shuffle(q['options'])

    return quiz[:num_questions]

def take_quiz(quiz):
    score = 0

    for q in quiz:
        print("\nQuestion:", q['question'])

        for i, option in enumerate(q['options'], 1):
            print(f"{i}. {option}")

        user_answer = input("Your answer (1, 2, 3, ...): ")

        if q['options'][int(user_answer) - 1] == q['correct']:
            print("Correct!")
            score += 1
        else:
            print(f"Wrong! The correct answer is: {q['correct']}")

    return score

def main():
    print("Welcome to the Quiz!")

    file_path = r"C:\Users\steve\Downloads\text_file1.csv"
    questions_data = read_questions_from_file(file_path)
    
    num_questions = int(input("Enter the number of questions to generate: "))
    randomize_questions = input("Randomize questions? (yes/no): ").lower() == 'yes'
    randomize_options = input("Randomize answer options? (yes/no): ").lower() == 'yes'

    quiz = generate_quiz(questions_data, num_questions, randomize_questions, randomize_options)

    score = take_quiz(quiz)

    print(f"\nYour total score: {score}/{num_questions}")

    retake = input("Do you want to retake the quiz? (yes/no): ").lower()
    if retake != 'yes':
        print("Thank you for taking the quiz. Goodbye!")

if __name__ == "__main__":
    main()

